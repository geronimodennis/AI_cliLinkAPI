{
  "name": "aiclitoaiapi",
  "version": "0.1.6",
  "description": "Native CLI gateway for a ChatGPT-authenticated Codex runtime.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geronimodennis/AIcliToAIapi.git"
  },
  "homepage": "https://github.com/geronimodennis/AIcliToAIapi#readme",
  "bugs": {
    "url": "https://github.com/geronimodennis/AIcliToAIapi/issues"
  },
  "type": "module",
  "bin": {
    "aiclitoaiapi": "dist/src/cli.js"
  },
  "files": [
    "dist/src/**/*.js",
    "docs/*.md",
    "examples/client.mjs",
    "aiclitoaiapi.example.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:isolation": "tsx --test test/isolation.integration.ts",
    "start": "node dist/src/cli.js serve",
    "aiclitoaiapi": "tsx src/cli.ts",
    "test:live": "tsx scripts/live.ts"
  },
  "dependencies": {
    "@openai/codex": "0.155.0",
    "@openai/codex-sdk": "0.155.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
